#Numerical results

classifier_types = ["logistic", "linear_svc", "rbf_svc", "histogram_svc"]

detector_type = 'SIFT'

codebook_size = 100

results = {}

for classifier_type in classifier_types:
    print(f"\n\n###############################")
    print(f"### Classifier Type: {classifier_type}")
    print(f"###############################")

    kfold = KFold(n_splits=3, shuffle=True, random_state=42)

    accuracies = []

    for fold, (train_idx, test_idx) in enumerate(kfold.split(data), start=1):
        print(f"\n========== Fold {fold} ==========")
        train_data = [data[i] for i in train_idx]
        test_data  = [data[i] for i in test_idx]

        # Usar el descriptor correspondiente
        bovw = BOVW(detector_type=detector_type, codebook_size=codebook_size)
        bovw, classifier = train(dataset=train_data, bovw=bovw, classifier_type=classifier_type)

        acc = test(dataset=test_data, bovw=bovw, classifier=classifier)
        accuracies.append(acc)

    print("\n========== 3-Fold Cross-Validation ==========")
    print("Accuracies per fold:", accuracies)
    print("Average accuracy:", np.mean(accuracies))

    results[classifier_type] = {
        "fold_accuracies": accuracies,
        "mean_accuracy": np.mean(accuracies)
    }

print("\n\n===== Summary over classifier_types =====")
for classifier_type in classifier_types:
    print(f"{classifier_type}: mean accuracy = {results[classifier_type]['mean_accuracy']:.4f}")
